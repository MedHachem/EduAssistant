# PostgreSQL (+ pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_education
POSTGRES_USER=ai_education
POSTGRES_PASSWORD=change-me

# Backend (Spring Boot)
JWT_SECRET=change-me
JWT_EXPIRATION_MINUTES=60
BACKEND_PORT=8080

# AI/RAG service (Python FastAPI)
AI_SERVICE_PORT=8000
ANTHROPIC_API_KEY=change-me
CLAUDE_MODEL=claude-sonnet-5

# Frontend (Angular)
FRONTEND_PORT=4200

# Gemini API (LLM Answer Generation, data/src/generate_answer.py)
GEMINI_API_KEY=change-me

# FastAPI API layer (data/src/api/) -- local development CORS only,
# never a hardcoded production origin
API_CORS_ORIGINS=http://localhost:4200
